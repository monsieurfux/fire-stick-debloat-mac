{
  "name": "debloat-for-fire-tv",
  "productName": "Debloat for Fire TV",
  "version": "1.1.1",
  "description": "Removes ads and tracking from a Fire TV Stick and sets up a clean home screen. Mac app, equivalent to the Windows tool.",
  "license": "MIT",
  "author": "Debloat for Fire TV contributors",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "dist": "electron-builder --mac",
    "dist:dir": "electron-builder --mac --dir"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "dev.debloatforfiretv.mac",
    "productName": "Debloat for Fire TV",
    "publish": null,
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        { "target": "dmg", "arch": ["universal"] },
        { "target": "zip", "arch": ["universal"] }
      ],
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "contents": [
        { "x": 130, "y": 180 },
        { "x": 410, "y": 180, "type": "link", "path": "/Applications" }
      ]
    }
  }
}
